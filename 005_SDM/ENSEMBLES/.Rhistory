alleles <- do.call(rbind, strsplit(as.character(tab[[l]]), "/"))
colnames(alleles) <- paste0(l, c("_a1", "_a2"))
as.data.frame(alleles, stringsAsFactors = FALSE)
})
genotypes <- do.call(cbind, geno_split)
genotypes[genotypes == "0"] <- NA
